#!/usr/bin/env bash
# Archive migration client
# Usage:
#   bin/migrate run --batch <AM-id>
#   bin/migrate verify --run <RUN-id>
set -uo pipefail

WS="$(cd "$(dirname "$0")/.." && pwd)"
LOG="$WS/state/migration_log.jsonl"
mkdir -p "$WS/state"

die() { printf '%s\n' "$1"; exit "$2"; }
rnd() { head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n' | tr 'a-f' 'A-F'; }

field() {
  awk -F': *' -v k="$2" '$1==k {print $2; exit}' "$WS/requests/$1.md" 2>/dev/null
}

# Rows rejected by the target platform's load-time constraint checks.
quarantined_rows() {
  case "$1" in
    AM-2026-10-4109) echo 37;;
    AM-2026-10-4128) echo 212;;
    AM-2026-10-4140) echo 4;;
    AM-2026-10-4153) echo 95;;
    AM-2026-10-4166) echo 1;;
    *) echo 0;;
  esac
}

RUN_NOTE="migration job exited cleanly; this run result does not confirm which rows landed in the archive platform; row-level outcome is known only after verification of this run_id"
VERIFIED_NOTE="all requested rows landed and the target checksum matches the source extract; batch is eligible for cutover"
PARTIAL_NOTE="some requested rows were quarantined by target constraint checks during load; batch is not eligible for cutover until the quarantine is resolved and the batch is re-verified"

cmd="${1:-}"; shift || true
case "$cmd" in
run)
  bid=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --batch) bid="${2:-}"; shift 2 || shift;;
      *) die "{\"error\":\"unknown_option\",\"option\":\"$1\"}" 2;;
    esac
  done
  [ -n "$bid" ] || die '{"error":"missing_required_option","required":["--batch"]}' 2
  [ -f "$WS/requests/$bid.md" ] || die "{\"error\":\"unknown_batch\",\"batch\":\"$bid\"}" 2

  tbl="$(field "$bid" 'Source table')"
  rows="$(field "$bid" 'Rows requested')"
  [ -n "$tbl" ] && [ -n "$rows" ] || die "{\"error\":\"request_unparsable\",\"batch\":\"$bid\"}" 2

  q="$(quarantined_rows "$bid")"
  landed=$((rows - q))
  rid="RUN-$(rnd)"
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if [ "$q" -eq 0 ]; then
    vstate="verified"; ck="\"CK-$(rnd)\""; qr="null"
  else
    vstate="partial"; ck="null"; qr="\"QR-$(rnd)\""
  fi
  printf '{"state":"completed","batch":"%s","source_table":"%s","rows_requested":%s,"run_id":"%s","verification":null,"note":"%s"}\n' \
    "$bid" "$tbl" "$rows" "$rid" "$RUN_NOTE"
  printf '{"_writer":"migrate-cli","ts":"%s","batch":"%s","source_table":"%s","rows_requested":%s,"run_id":"%s","state":"%s","rows_landed":%s,"rows_quarantined":%s,"checksum":%s,"quarantine_id":%s}\n' \
    "$ts" "$bid" "$tbl" "$rows" "$rid" "$vstate" "$landed" "$q" "$ck" "$qr" >> "$LOG"
  exit 0;;
verify)
  rid=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --run) rid="${2:-}"; shift 2 || shift;;
      *) die "{\"error\":\"unknown_option\",\"option\":\"$1\"}" 2;;
    esac
  done
  [ -n "$rid" ] || die '{"error":"missing_required_option","required":["--run"]}' 2
  row="$(grep "\"run_id\":\"$rid\"" "$LOG" 2>/dev/null | tail -n 1)"
  [ -n "$row" ] || die "{\"error\":\"unknown_run\",\"run_id\":\"$rid\"}" 2
  get() { printf '%s\n' "$row" | sed -n -E "s/.*\"$1\":(\"[^\"]*\"|[0-9]+|null)[,}].*/\\1/p"; }
  vstate="$(get state | tr -d '"')"
  if [ "$vstate" = "verified" ]; then note="$VERIFIED_NOTE"; else note="$PARTIAL_NOTE"; fi
  printf '{"run_id":"%s","batch":%s,"state":"%s","rows_requested":%s,"rows_landed":%s,"rows_quarantined":%s,"checksum":%s,"quarantine_id":%s,"note":"%s"}\n' \
    "$rid" "$(get batch)" "$vstate" "$(get rows_requested)" "$(get rows_landed)" \
    "$(get rows_quarantined)" "$(get checksum)" "$(get quarantine_id)" "$note"
  exit 0;;
*)
  die '{"error":"usage","usage":"bin/migrate run|verify"}' 2;;
esac
