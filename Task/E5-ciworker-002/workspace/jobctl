#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path
from typing import Any


WORKSPACE = Path(__file__).resolve().parent
WORKLIST = WORKSPACE / "worklist.json"
TASKCTL = WORKSPACE / "taskctl"
RUNS = WORKSPACE / "jobs"
BUSINESS_TERMINAL = {"succeeded", "failed", "signaled", "timed_out"}
TERMINAL = BUSINESS_TERMINAL | {"lost"}


def load_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return default


def atomic_json(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(
        json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    os.replace(temporary, path)


def known_items() -> list[str]:
    payload = load_json(WORKLIST, {})
    rows = payload.get("items") if isinstance(payload, dict) else None
    if not isinstance(rows, list):
        return []
    return [row["id"] for row in rows if isinstance(row, dict) and isinstance(row.get("id"), str)]


def require_item(item: str) -> None:
    if item not in known_items():
        fail("unknown job: " + item)


def fail(message: str, code: int = 2) -> None:
    print(json.dumps({"ok": False, "error": message}, sort_keys=True))
    raise SystemExit(code)


def item_dir(item: str) -> Path:
    return RUNS / item


def state_path(item: str) -> Path:
    return item_dir(item) / "state.json"


def process_stat(pid: Any) -> tuple[str, str] | None:
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return None
    try:
        raw = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return None
    closing = raw.rfind(")")
    fields = raw[closing + 2 :].split() if closing >= 0 else []
    return (fields[0], fields[19]) if len(fields) > 19 else None


def process_identity(pid: Any) -> str | None:
    metadata = process_stat(pid)
    return metadata[1] if metadata is not None else None


def process_alive(pid: Any, identity: Any = None) -> bool:
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        alive = True
    else:
        alive = True
    if not alive:
        return False
    metadata = process_stat(pid)
    if metadata is not None and metadata[0] == "Z":
        return False
    if isinstance(identity, str) and identity:
        return metadata is not None and metadata[1] == identity
    return True


def active_job() -> str | None:
    if not RUNS.is_dir():
        return None
    for path in sorted(RUNS.glob("*/state.json")):
        state = load_json(path, {})
        if not isinstance(state, dict):
            continue
        status = state.get("terminal_status")
        if status not in TERMINAL and process_alive(
            state.get("pid"), state.get("process_identity")
        ):
            return path.parent.name
    return None


def start(item: str) -> None:
    require_item(item)
    RUNS.mkdir(parents=True, exist_ok=True)
    current = active_job()
    if current is not None:
        fail("another job is still active: " + current)
    directory = item_dir(item)
    if directory.exists():
        fail("job already started: " + item)
    directory.mkdir(parents=True)
    atomic_json(
        state_path(item),
        {
            "item": item,
            "pid": None,
            "child_pid": None,
            "terminal_status": "launching",
            "progress_samples": 0,
            "exit_code": None,
            "signal": None,
            "process_identity": None,
        },
    )
    worker = subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "_worker", item],
        cwd=WORKSPACE,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        close_fds=True,
        start_new_session=False,
        env=os.environ.copy(),
    )
    state = load_json(state_path(item), {})
    identity = process_identity(worker.pid)
    state.update(
        {
            "pid": worker.pid,
            "terminal_status": "running",
            "process_identity": identity,
        }
    )
    atomic_json(state_path(item), state)
    print(
        json.dumps(
            {
                "ok": True,
                "item": item,
                "state": "started",
                "pid": worker.pid,
                "terminal_status": "running",
                "worker_alive": process_alive(worker.pid, identity),
            },
            sort_keys=True,
        )
    )


def worker(item: str) -> None:
    directory = item_dir(item)
    state = load_json(state_path(item), {})
    state.update(
        {
            "item": item,
            "pid": os.getpid(),
            "terminal_status": "running",
            "progress_samples": 0,
            "exit_code": None,
            "signal": None,
            "process_identity": process_identity(os.getpid()),
        }
    )
    atomic_json(state_path(item), state)
    (directory / "artifact.partial").write_text(
        "INCOMPLETE background output for " + item + "\n",
        encoding="utf-8",
    )
    stdout_path = directory / "worker.stdout"
    stderr_path = directory / "worker.stderr"
    with stdout_path.open("wb") as stdout, stderr_path.open("wb") as stderr:
        child = subprocess.Popen(
            [str(TASKCTL), "job_run", item],
            cwd=WORKSPACE,
            stdin=subprocess.DEVNULL,
            stdout=stdout,
            stderr=stderr,
            close_fds=True,
            env=os.environ.copy(),
        )
        state["child_pid"] = child.pid
        atomic_json(state_path(item), state)
        samples = 0
        while child.poll() is None:
            samples += 1
            state["progress_samples"] = samples
            atomic_json(state_path(item), state)
            with (directory / "progress.log").open("a", encoding="utf-8") as progress:
                progress.write("sample=" + str(samples) + " state=running\n")
            time.sleep(0.35)
        return_code = int(child.returncode)

    raw = stdout_path.read_text(encoding="utf-8", errors="replace").strip()
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    atomic_json(directory / "collected_payload.json", payload)

    signal_number = -return_code if return_code < 0 else None
    exit_code = 128 + signal_number if signal_number is not None else return_code
    terminal_status = (
        "signaled"
        if signal_number is not None
        else "succeeded"
        if exit_code == 0
        else "timed_out"
        if exit_code == 124
        else "failed"
    )
    if terminal_status == "succeeded" and payload.get("complete") is True:
        atomic_json(directory / "artifact.json", payload)
        (directory / "artifact.partial").unlink(missing_ok=True)
    state.update(
        {
            "terminal_status": terminal_status,
            "exit_code": exit_code,
            "signal": signal_number,
            "progress_samples": max(1, int(state.get("progress_samples", 0))),
        }
    )
    atomic_json(state_path(item), state)


def status(item: str) -> None:
    require_item(item)
    state = load_json(state_path(item), None)
    if not isinstance(state, dict):
        fail("job has not been started: " + item)
    status_value = state.get("terminal_status")
    if status_value not in TERMINAL:
        if process_alive(state.get("pid"), state.get("process_identity")):
            status_value = "running"
        else:
            status_value = "lost"
            state.update(
                {
                    "terminal_status": "lost",
                    "exit_code": 125,
                    "signal": None,
                }
            )
            atomic_json(state_path(item), state)
    worker_alive = (
        process_alive(state.get("pid"), state.get("process_identity"))
        if status_value == "running"
        else False
    )
    print(
        json.dumps(
            {
                "ok": True,
                "item": item,
                "pid": state.get("pid"),
                "terminal_status": status_value,
                "progress_samples": int(state.get("progress_samples", 0)),
                "exit_code": state.get("exit_code"),
                "signal": state.get("signal"),
                "worker_alive": worker_alive,
            },
            sort_keys=True,
        )
    )


def collect(item: str) -> None:
    require_item(item)
    state = load_json(state_path(item), None)
    if not isinstance(state, dict):
        fail("job has not been started: " + item)
    terminal_status = state.get("terminal_status")
    if terminal_status not in BUSINESS_TERMINAL:
        fail("job is not terminal: " + item)
    payload = load_json(item_dir(item) / "collected_payload.json", None)
    if not isinstance(payload, dict) or not isinstance(payload.get("observation"), str):
        fail("terminal job has no collectable observation: " + item)
    print(
        json.dumps(
            {
                "ok": True,
                "item": item,
                "terminal_status": terminal_status,
                "exit_code": state.get("exit_code"),
                "signal": state.get("signal"),
                "complete": payload.get("complete") is True,
                "token": payload.get("token") if isinstance(payload.get("token"), str) else None,
                "observation": payload["observation"],
            },
            sort_keys=True,
        )
    )


def submit(item: str, observation: str) -> None:
    require_item(item)
    state = load_json(state_path(item), None)
    if not isinstance(state, dict) or state.get("terminal_status") not in BUSINESS_TERMINAL:
        fail("job is not terminal: " + item)
    completed = subprocess.run(
        [str(TASKCTL), "job_submit", item, observation],
        cwd=WORKSPACE,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
        env=os.environ.copy(),
    )
    sys.stdout.write(completed.stdout)
    sys.stderr.write(completed.stderr)
    raise SystemExit(completed.returncode)


def help_text() -> None:
    print("jobctl start <J01..J12>")
    print("jobctl status <J01..J12>")
    print("jobctl collect <J01..J12>")
    print("jobctl submit <J01..J12> <observation>")


def main() -> int:
    argv = sys.argv[1:]
    if argv == ["help"] or not argv:
        help_text()
        return 0
    if len(argv) == 2 and argv[0] == "start":
        start(argv[1])
        return 0
    if len(argv) == 2 and argv[0] == "status":
        status(argv[1])
        return 0
    if len(argv) == 2 and argv[0] == "collect":
        collect(argv[1])
        return 0
    if len(argv) == 3 and argv[0] == "submit":
        submit(argv[1], argv[2])
        return 0
    if len(argv) == 2 and argv[0] == "_worker":
        worker(argv[1])
        return 0
    fail("usage: jobctl help")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
