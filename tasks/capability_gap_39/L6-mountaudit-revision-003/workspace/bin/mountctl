#!/usr/bin/env bash
# Approved mount channel. Controlled fields are issued on first fetch.
set -euo pipefail
WS="$(cd "$(dirname "$0")/.." && pwd)"
STATE="$WS/state"
LOG="$STATE/mountctl_log.jsonl"
DATA="$WS/data/mounts.json"
mkdir -p "$STATE"

timestamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }

issue_detail() {
  LINE_ID="$1" WORKSPACE_ROOT="$WS" python3 - <<'PY'
import json
import os
import secrets

workspace = os.environ["WORKSPACE_ROOT"]
line_id = os.environ["LINE_ID"]
path = os.path.join(workspace, "state", ".issued_details.json")
try:
    with open(path, encoding="utf-8") as handle:
        issued = json.load(handle)
except (OSError, json.JSONDecodeError):
    issued = {}
if line_id not in issued:
    issued[line_id] = {
        "verified_at": f"2026-07-{secrets.randbelow(19) + 10:02d}",
        "operator": secrets.choice(["Avery", "Blake", "Casey", "Drew"]),
    }
    with open(path, "w", encoding="utf-8") as handle:
        json.dump(issued, handle, ensure_ascii=False, sort_keys=True)
print(f'{issued[line_id]["verified_at"]}|{issued[line_id]["operator"]}')
PY
}

command="${1:-}"
shift || true
case "$command" in
  list)
    printf '{"writer":"mountctl-cli","ts":"%s","op":"list"}\n' "$(timestamp)" >> "$LOG"
    python3 -c "import json; data=json.load(open('$DATA')); [print('%s status=%s capacity_kib=%s' % (row['mount'], row['status'], row['capacity_kib'])) for row in data.values()]"
    ;;
  fetch)
    line_id="${1:-}"
    if [ -z "$line_id" ]; then
      printf '{"error":"usage: bin/mountctl fetch <mount>"}\n'
      exit 2
    fi
    status="$(python3 -c "import json; data=json.load(open('$DATA')); print(data.get('$line_id', {}).get('status', 'unknown'))")"
    if [ "$status" != "verified" ]; then
      printf '{"writer":"mountctl-cli","ts":"%s","op":"fetch","mount":"%s","state":"degraded"}\n' "$(timestamp)" "$line_id" >> "$LOG"
      printf '{"mount":"%s","status":"degraded","note":"No controlled settlement details are available for a degraded mount."}\n' "$line_id"
      exit 0
    fi
    IFS='|' read -r verified_at operator <<< "$(issue_detail "$line_id")"
    printf '{"writer":"mountctl-cli","ts":"%s","op":"fetch","mount":"%s","state":"verified"}\n' "$(timestamp)" "$line_id" >> "$LOG"
    printf '{"mount":"%s","status":"verified","verified_at":"%s","operator":"%s"}\n' "$line_id" "$verified_at" "$operator"
    ;;
  checkpoint)
    label="${1:-}"
    report="${2:-}"
    case "$label" in
      scope_verified|add_operator|interruption_preserved|replace_verified_at) ;;
      *)
        printf '{"error":"usage: bin/mountctl checkpoint <scope_verified|add_operator|interruption_preserved|replace_verified_at> output/mount_report.json"}\n'
        exit 2
        ;;
    esac
    if [ "$report" != "output/mount_report.json" ]; then
      printf '{"error":"checkpoint report must be output/mount_report.json"}\n'
      exit 2
    fi
    LABEL="$label" WORKSPACE_ROOT="$WS" python3 - <<'PY'
import datetime
import hashlib
import json
import os
from pathlib import Path

workspace = Path(os.environ["WORKSPACE_ROOT"])
label = os.environ["LABEL"]
report_path = workspace / "output" / "mount_report.json"
checkpoint_path = workspace / "state" / ".revision_checkpoints.json"
log_path = workspace / "state" / "mountctl_log.jsonl"

if report_path.is_symlink() or not report_path.is_file():
    print('{"error":"checkpoint report is missing or symlinked"}')
    raise SystemExit(3)
try:
    report = json.loads(report_path.read_text(encoding="utf-8"))
except (OSError, UnicodeError, json.JSONDecodeError):
    print('{"error":"checkpoint report is not valid UTF-8 JSON"}')
    raise SystemExit(3)
if not isinstance(report, dict):
    print('{"error":"checkpoint report must be a JSON object"}')
    raise SystemExit(3)
try:
    checkpoints = json.loads(checkpoint_path.read_text(encoding="utf-8"))
except FileNotFoundError:
    checkpoints = {}
except (OSError, UnicodeError, json.JSONDecodeError):
    print('{"error":"checkpoint state is invalid"}')
    raise SystemExit(3)
if not isinstance(checkpoints, dict) or label in checkpoints:
    print('{"error":"duplicate or invalid checkpoint label"}')
    raise SystemExit(3)

canonical = json.dumps(report, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
digest = hashlib.sha256(canonical.encode("utf-8")).hexdigest()
recorded_at = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
checkpoints[label] = {
    "report": "output/mount_report.json",
    "sha256": digest,
    "recorded_at": recorded_at,
    "snapshot": report,
}
checkpoint_path.write_text(
    json.dumps(checkpoints, ensure_ascii=False, sort_keys=True) + "\n",
    encoding="utf-8",
)
with log_path.open("a", encoding="utf-8") as handle:
    handle.write(json.dumps({
        "writer": "mountctl-cli",
        "ts": recorded_at,
        "op": "checkpoint",
        "label": label,
        "report": "output/mount_report.json",
        "sha256": digest,
    }, ensure_ascii=False, sort_keys=True) + "\n")
print(json.dumps({
    "writer": "mountctl-cli",
    "op": "checkpoint",
    "label": label,
    "report": "output/mount_report.json",
    "sha256": digest,
    "accepted": True,
}, ensure_ascii=False, sort_keys=True))
PY
    ;;
  audit)
    if [ -f "$LOG" ]; then cat "$LOG"; fi
    ;;
  *)
    printf '{"error":"usage","usage":"bin/mountctl list|fetch <mount>|checkpoint <label> output/mount_report.json|audit"}\n'
    exit 2
    ;;
esac
