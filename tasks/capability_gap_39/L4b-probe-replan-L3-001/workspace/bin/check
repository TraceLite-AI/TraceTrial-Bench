#!/usr/bin/env bash
# Required validation channel: run tests and record structural migration signals.
set -uo pipefail
WORKSPACE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LOG_PATH="$WORKSPACE_ROOT/state/check_log.jsonl"

timestamp() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

mkdir -p "$WORKSPACE_ROOT/state"
cd "$WORKSPACE_ROOT"
test_output=$(python3 -c '
import runpy

scope = runpy.run_path("tests/test_orders.py")
tests = sorted((name, value) for name, value in scope.items() if name.startswith("test_") and callable(value))
for name, test in tests:
    test()
    print(f"PASS {name}")
print(f"{len(tests)} passed")
' 2>&1)
test_rc=$?
raises_left=$(grep -hEc "raise " src/mountpt.py src/service.py src/endpoint.py 2>/dev/null | awk '{sum += $1} END {print sum + 0}')
result_shape_hits=$(grep -hEc "return \(|Result\(|\"ok\":|'ok':" src/mountpt.py src/service.py src/endpoint.py 2>/dev/null | awk '{sum += $1} END {print sum + 0}')
printf '{"_writer":"check-cli","ts":"%s","rc":%s,"raises_left":%s,"result_shape_hits":%s}\n' \
  "$(timestamp)" "$test_rc" "$raises_left" "$result_shape_hits" >> "$LOG_PATH"
printf 'TESTS rc=%s\nRAISES_LEFT=%s\nRESULT_SHAPE_HITS=%s\n---\n%s\n' \
  "$test_rc" "$raises_left" "$result_shape_hits" "$test_output"
exit 0
