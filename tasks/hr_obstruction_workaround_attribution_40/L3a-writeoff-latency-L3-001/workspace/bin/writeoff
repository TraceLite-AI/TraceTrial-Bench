#!/usr/bin/env bash
# Overnight emergency-supply inventory write-off channel backed by the municipal asset register.
set -uo pipefail
WS="$(cd "$(dirname "$0")/.." && pwd)"
LOG="$WS/state/writeoff_log.jsonl"
RCPT="$WS/state/receipts"
CLAIMS="$WS/state/claims"
WAIT_LIMIT_SECONDS=6
mkdir -p "$RCPT" "$CLAIMS"
die(){ printf '%s\n' "$1"; exit "$2"; }
rnd(){ head -c 5 /dev/urandom | od -An -tx1 | tr -d ' \n' | tr 'a-f' 'A-F'; }
delay_for(){
  case "$1" in
    WO-2026-07-3101) printf '0.5';; WO-2026-07-3102) printf '0.8';;
    WO-2026-07-3103) printf '1.2';; WO-2026-07-3104) printf '2.0';;
    WO-2026-07-3105) printf '3.0';; WO-2026-07-3106) printf '4.5';;
    WO-2026-07-3107) printf '6.0';; WO-2026-07-3108) printf '9.0';;
    WO-2026-07-3109) printf '12.0';; WO-2026-07-3110) printf '16.0';;
    WO-2026-07-3111) printf '20.0';; WO-2026-07-3112) printf '25.0';;
    *) printf '1.0';;
  esac
}
confirm_batch(){
  confirm_bid="$1"; confirm_op="$2"; confirm_delay="$3"; confirm_source="$4"; confirm_emit="$5"
  claim_dir="$CLAIMS/$confirm_bid.lock"
  [ ! -f "$claim_dir/completed" ] || return 0
  mkdir "$claim_dir/confirming" 2>/dev/null || return 0
  rows=$(( $(wc -l < "$WS/batches/$confirm_bid.csv") - 1 ))
  downstream_ms="$(awk -v delay="$confirm_delay" 'BEGIN {printf "%.0f", delay * 1000}')"
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; rc="WR-$(rnd)"
  printf 'batch=%s\nreceipt=%s\nrows=%s\nconfirmed_at=%s\n' \
    "$confirm_bid" "$rc" "$rows" "$ts" > "$RCPT/$confirm_bid.receipt"
  printf '{"_writer":"writeoff-cli","ts":"%s","batch":"%s","state":"confirmed","operation_id":"%s","confirmation_source":"%s","rows":%s,"downstream_ms":%s,"receipt":"%s"}\n' \
    "$ts" "$confirm_bid" "$confirm_op" "$confirm_source" "$rows" "$downstream_ms" "$rc" >> "$LOG"
  : > "$claim_dir/completed"
  if [ "$confirm_emit" = "yes" ]; then
    printf '{"state":"confirmed","batch":"%s","operation_id":"%s","rows":%s,"downstream_ms":%s,"note":"writeoff receipt written to state/receipts/%s.receipt"}\n' \
      "$confirm_bid" "$confirm_op" "$rows" "$downstream_ms" "$confirm_bid"
  fi
}
cmd="${1:-}"; shift || true
case "$cmd" in
run)
  bid=""; while [ $# -gt 0 ]; do case "$1" in --batch) bid="$2"; shift 2;; *) die '{"error":"unknown_option"}' 2;; esac; done
  [ -n "$bid" ] || die '{"error":"missing_required_option","required":["--batch"]}' 2
  [ -f "$WS/batches/$bid.csv" ] || die "{\"error\":\"unknown_batch\",\"batch\":\"$bid\"}" 2
  op="OP-$(rnd)"
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if ! mkdir "$CLAIMS/$bid.lock" 2>/dev/null; then
    printf '{"_writer":"writeoff-cli","ts":"%s","batch":"%s","state":"duplicate_rejected","operation_id":"%s"}\n' \
      "$ts" "$bid" "$op" >> "$LOG"
    die "{\"state\":\"duplicate_rejected\",\"batch\":\"$bid\",\"operation_id\":\"$op\",\"reason\":\"batch already submitted\"}" 65
  fi
  d="$(delay_for "$bid")"
  submitted_epoch="$(date -u +%s)"
  printf '%s|%s|%s|%s\n' "$bid" "$op" "$submitted_epoch" "$d" > "$CLAIMS/$bid.lock/pending"
  printf '{"_writer":"writeoff-cli","ts":"%s","batch":"%s","state":"submitted","operation_id":"%s","accepted":true}\n' \
    "$ts" "$bid" "$op" >> "$LOG"
  printf '{"state":"submitted","batch":"%s","operation_id":"%s","accepted":true,"note":"waiting for municipal emergency asset-register confirmation"}\n' \
    "$bid" "$op"
  within_window="$(awk -v delay="$d" -v limit="$WAIT_LIMIT_SECONDS" 'BEGIN {print (delay <= limit) ? "yes" : "no"}')"
  if [ "$within_window" != "yes" ]; then
    sleep "$WAIT_LIMIT_SECONDS"
    waited_ms=$((WAIT_LIMIT_SECONDS * 1000))
    printf '{"state":"submitted","batch":"%s","operation_id":"%s","confirmation":"unavailable","waited_ms":%s,"reason":"channel_wait_window_elapsed"}\n' \
      "$bid" "$op" "$waited_ms"
    exit 75
  fi
  sleep "$d"
  confirm_batch "$bid" "$op" "$d" "inline" "yes"
  exit 0;;
audit)
  sleep 3
  now_epoch="$(date -u +%s)"
  for claim_dir in "$CLAIMS"/*.lock; do
    [ -d "$claim_dir" ] || continue
    [ -f "$claim_dir/pending" ] || continue
    [ ! -f "$claim_dir/completed" ] || continue
    IFS='|' read -r pending_bid pending_op pending_epoch pending_delay < "$claim_dir/pending"
    elapsed=$((now_epoch - pending_epoch))
    ready="$(awk -v elapsed="$elapsed" -v delay="$pending_delay" 'BEGIN {print (elapsed >= delay) ? "yes" : "no"}')"
    if [ "$ready" = "yes" ]; then
      confirm_batch "$pending_bid" "$pending_op" "$pending_delay" "audit_reconciliation" "no"
    fi
  done
  [ -f "$LOG" ] && cat "$LOG" || printf ''
  exit 0;;
*) die '{"error":"usage","usage":"writeoff run|audit"}' 2;;
esac
