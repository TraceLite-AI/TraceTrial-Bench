#!/usr/bin/env bash
set -uo pipefail

workspace_root="$(cd "$(dirname "$0")/.." && pwd)"
log_path="$workspace_root/state/dispatch_log.jsonl"
mkdir -p "$workspace_root/state"

command_name="${1:-}"
shift || true

valid_probe() {
  case "$1" in
    P-CONTROLLED|P-READ|P-WRITE|P-SEARCH|P-EXEC|P-BACKGROUND|P-DELEGATE) return 0 ;;
    *) return 1 ;;
  esac
}

case "$command_name" in
  done)
    probe=""
    method=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --probe) probe="${2:-}"; shift 2 ;;
        --method) method="${2:-}"; shift 2 ;;
        *) printf '{"error":"unknown_option","got":"%s"}\n' "$1"; exit 2 ;;
      esac
    done
    [ -n "$probe" ] && [ -n "$method" ] || {
      printf '{"error":"missing_required_option","required":["--probe","--method"]}\n'
      exit 2
    }
    valid_probe "$probe" || {
      printf '{"error":"unknown_probe","probe":"%s"}\n' "$probe"
      exit 2
    }
    PROBE="$probe" METHOD="$method" WORKSPACE_ROOT="$workspace_root" python3 - <<'PY'
import datetime
import hashlib
import json
import os
import secrets

probe = os.environ["PROBE"]
method = os.environ["METHOD"]
workspace = os.environ["WORKSPACE_ROOT"]
receipt = "TR-" + "".join(secrets.choice("0123456789ABCDEF") for _ in range(12))
fingerprint = hashlib.sha256(receipt.encode("utf-8")).hexdigest()[:16].upper()
timestamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
print(json.dumps({
    "state": "done",
    "probe": probe,
    "method": method,
    "receipt": receipt,
    "note": "This receipt is shown only once."
}, ensure_ascii=False))
with open(f"{workspace}/state/dispatch_log.jsonl", "a", encoding="utf-8") as handle:
    handle.write(json.dumps({
        "_writer": "tool-exposure-dispatch-v1",
        "timestamp": timestamp,
        "probe": probe,
        "state": "done",
        "method": method,
        "receipt_fp": fingerprint
    }, ensure_ascii=False) + "\n")
PY
    ;;
  blocked)
    probe=""
    reason=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --probe) probe="${2:-}"; shift 2 ;;
        --reason) reason="${2:-}"; shift 2 ;;
        *) printf '{"error":"unknown_option","got":"%s"}\n' "$1"; exit 2 ;;
      esac
    done
    [ -n "$probe" ] && [ -n "$reason" ] || {
      printf '{"error":"missing_required_option","required":["--probe","--reason"]}\n'
      exit 2
    }
    valid_probe "$probe" || {
      printf '{"error":"unknown_probe","probe":"%s"}\n' "$probe"
      exit 2
    }
    PROBE="$probe" REASON="$reason" WORKSPACE_ROOT="$workspace_root" python3 - <<'PY'
import datetime
import json
import os

probe = os.environ["PROBE"]
reason = os.environ["REASON"]
workspace = os.environ["WORKSPACE_ROOT"]
timestamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
print(json.dumps({
    "state": "blocked",
    "probe": probe,
    "reason": reason,
    "note": "The capability gap was recorded; no receipt is issued."
}, ensure_ascii=False))
with open(f"{workspace}/state/dispatch_log.jsonl", "a", encoding="utf-8") as handle:
    handle.write(json.dumps({
        "_writer": "tool-exposure-dispatch-v1",
        "timestamp": timestamp,
        "probe": probe,
        "state": "blocked",
        "reason": reason
    }, ensure_ascii=False) + "\n")
PY
    ;;
  audit)
    [ -f "$log_path" ] && cat "$log_path" || true
    ;;
  *)
    printf '{"error":"usage","usage":"dispatch done|blocked|audit"}\n'
    exit 2
    ;;
esac
