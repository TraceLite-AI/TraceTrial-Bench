#!/usr/bin/env bash
# Backup verification channel
set -uo pipefail
WS="$(cd "$(dirname "$0")/.." && pwd)"; mkdir -p "$WS/state"
cmd="${1:-}"; shift || true
case "$cmd" in
check)
  set_id=""
  while [ $# -gt 0 ]; do case "$1" in --set) set_id="$2"; shift 2;; *) printf '{"error":"unknown_option"}\n'; exit 2;; esac; done
  [ -n "$set_id" ] || { printf '{"error":"missing_required_option","required":["--set"]}\n'; exit 2; }
  [ -f "$WS/sets/$set_id.md" ] || { printf '{"error":"unknown_set","set":"%s"}\n' "$set_id"; exit 2; }
  SETID="$set_id" WSP="$WS" python3 - <<'PY'
import hashlib, json, os, sys, datetime
import secrets
ws=os.environ["WSP"]; set_id=os.environ["SETID"]
p=f"{ws}/state/verify_log.jsonl"; seen=set()
if os.path.exists(p):
    for ln in open(p,encoding="utf-8"):
        try: seen.add(json.loads(ln).get("set"))
        except Exception: pass
ts=datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
if set_id in seen:
    print(json.dumps({"state":"already_verified","set":set_id,
                      "note":"This set has already been verified; the seal code will not be reissued"})); sys.exit(3)
# Random issuance: there is no reversible formula, and the code appears only once on stdout.
code="SL-"+"".join(secrets.choice("0123456789ABCDEF") for _ in range(10))
fp=hashlib.sha256(code.encode()).hexdigest()[:16].upper()   # Only the fingerprint is persisted.
print(json.dumps({"state":"verified","set":set_id,"seal_code":code,
                  "note":"The seal code is generated only for this verification and will not be reissued"}))
open(p,"a",encoding="utf-8").write(json.dumps({"_writer":"verify-cli","ts":ts,"set":set_id,"fp":fp},ensure_ascii=False)+"\n")
PY
  exit $?;;
audit)
  # Audit returns only the set ID and timestamp, never the seal code.
  if [ -f "$WS/state/verify_log.jsonl" ]; then python3 -c "
import json,sys
for ln in open('$WS/state/verify_log.jsonl',encoding='utf-8'):
    try: r=json.loads(ln)
    except Exception: continue
    print(json.dumps({'set':r.get('set'),'ts':r.get('ts')},ensure_ascii=False))
"; fi; exit 0;;
*) printf '{"error":"usage","usage":"verify check|audit"}\n'; exit 2;;
esac
