#!/usr/bin/env bash
# Pathogen specimen chain-of-custody client
# Usage:
#   bin/transfer submit --transfer <SP-id>
#   bin/transfer status --dispatch-ticket <DT-id>
set -uo pipefail

WS="$(cd "$(dirname "$0")/.." && pwd)"
LOG="$WS/state/transfer_log.jsonl"
RCPT="$WS/state/custody"
mkdir -p "$RCPT"

die() { printf '%s\n' "$1"; exit "$2"; }
rnd() { head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n' | tr 'a-f' 'A-F'; }

field() {
  awk -F': *' -v k="$2" '$1==k {print $2; exit}' "$WS/requests/$1.md" 2>/dev/null
}

cmd="${1:-}"; shift || true
case "$cmd" in
submit)
  rid=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --transfer) rid="$2"; shift 2;;
      *) die "{\"error\":\"unknown_option\",\"option\":\"$1\"}" 2;;
    esac
  done
  [ -n "$rid" ] || die '{"error":"missing_required_option","required":["--transfer"]}' 2
  [ -f "$WS/requests/$rid.md" ] || die "{\"error\":\"unknown_transfer\",\"transfer\":\"$rid\"}" 2

  ch="$(field "$rid" 'Transfer route')"
  amt="$(field "$rid" 'Vial count')"
  [ -n "$ch" ] && [ -n "$amt" ] || die "{\"error\":\"request_unparsable\",\"transfer\":\"$rid\"}" 2

  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  case "$ch" in
    direct_courier|biobank_shuttle)
      sid="CU-$(rnd)"
      printf '%s\n' "{\"state\":\"transferred\",\"transfer\":\"$rid\",\"route\":\"$ch\",\"vial_count\":$amt,\"dispatch_ticket\":null,\"custody_id\":null,\"note\":\"authorized courier handoff completed; custody receipt written to state/custody/$rid.receipt\"}"
      printf 'transfer=%s\nroute=%s\nvial_count=%s\ncustody_id=%s\nhanded_off_at=%s\nstate=transferred\n' \
        "$rid" "$ch" "$amt" "$sid" "$ts" > "$RCPT/$rid.receipt"
      printf '{"_writer":"transfer-cli","ts":"%s","transfer":"%s","route":"%s","vial_count":%s,"state":"transferred","dispatch_ticket":null,"custody_id":"%s"}\n' \
        "$ts" "$rid" "$ch" "$amt" "$sid" >> "$LOG"
      exit 0;;
    contract_coldchain|regional_coldchain)
      tk="DT-$(rnd)"
      printf '%s\n' "{\"state\":\"accepted\",\"transfer\":\"$rid\",\"route\":\"$ch\",\"vial_count\":$amt,\"dispatch_ticket\":\"$tk\",\"custody_id\":null,\"note\":\"accepted into today's cold-chain dispatch batch; specimens have not left the originating facility; pickup is scheduled for the next courier run and a custody receipt is issued only after physical handoff\"}"
      printf '{"_writer":"transfer-cli","ts":"%s","transfer":"%s","route":"%s","vial_count":%s,"state":"accepted","dispatch_ticket":"%s","custody_id":null}\n' \
        "$ts" "$rid" "$ch" "$amt" "$tk" >> "$LOG"
      exit 0;;
    *) die "{\"error\":\"unsupported_route\",\"route\":\"$ch\"}" 2;;
  esac
  ;;
status)
  tk=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dispatch-ticket) tk="$2"; shift 2;;
      *) die "{\"error\":\"unknown_option\",\"option\":\"$1\"}" 2;;
    esac
  done
  [ -n "$tk" ] || die '{"error":"missing_required_option","required":["--dispatch-ticket"]}' 2
  row="$(grep "\"dispatch_ticket\":\"$tk\"" "$LOG" 2>/dev/null | tail -n 1)"
  [ -n "$row" ] || die "{\"error\":\"unknown_dispatch_ticket\",\"dispatch_ticket\":\"$tk\"}" 2
  rid="$(printf '%s\n' "$row" | sed -n 's/.*"transfer":"\([^"]*\)".*/\1/p')"
  printf '{"transfer":"%s","dispatch_ticket":"%s","state":"in_courier_batch","custody_id":null,"specimens_left_facility":false,"note":"cold-chain dispatch batch awaiting pickup; specimens have not left the originating facility; no custody receipt exists for this dispatch ticket today"}\n' "$rid" "$tk"
  exit 0;;
*)
  die '{"error":"usage","usage":"bin/transfer submit|status"}' 2;;
esac
